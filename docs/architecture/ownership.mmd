title: 代码所有权边界｜实线：调用与数据 · 虚线：装配与启停
config:
  flowchart:
    wrappingWidth: 320
---
flowchart TB
  subgraph DSH["① 上游 DSH｜本地 npm 依赖 · Agent 运行内核"]
    agent["DSH Web / SDK 运行时<br/>规划 · 模型调用 · 工具循环<br/>会话事件 · Skill 加载<br/>业务授权与发送许可由火火核验"]
    sessions[("DSH 持久状态<br/>会话与模型配置")]
    agent <--> sessions
  end

  subgraph PRODUCT["② 火火接入层｜本仓 product"]
    profiles["Profile / Bundle<br/>聊天 · 研究 · 策略的运行配置"]
    plugins["火火扩展插件<br/>UI · Tool · Skill · guard<br/>在 DSH 宿主内加载<br/>正式业务状态由 sidecar 持有"]
  end

  subgraph BUSINESS["③ 火火业务内核｜本仓 sidecar · Python 进程"]
    api["受控 API 与领域服务<br/>委托与执行 · 证据 · 投资事实<br/>策略验证 · 联系决定 · 通知<br/>程序校验授权、版本与副作用"]
    db[("实例业务 SQLite<br/>委托 / 证据 / 投资事实 / 通知")]
    api <--> db
  end

  subgraph RUNTIME["④ 火火运行管理｜本仓 distribution / runtime"]
    life["安装与实例管理<br/>环境适配 · 版本匹配 · 进程启停"]
    worker["后台 worker · 业务执行驱动<br/>领取 · 续租 · 取消 · 回写<br/>按任务选择程序执行或 DSH 研究<br/>Agent 循环仍由 DSH 执行"]
    life -.->|"管理生命周期"| worker
  end

  profiles -.->|"装配配置与权限集合"| agent
  agent <-->|"DSH 扩展协议<br/>工具调用 / 方法加载 / UI 接入"| plugins
  plugins <-->|"受控命令与查询"| api
  worker <-->|"官方 HarnessClient<br/>提交研究 / 接收事件与结果"| agent
  worker <-->|"资料发现 / 任务与结果交接"| api
  life -.->|"启动 DSH 宿主"| agent
  life -.->|"启动侧车"| api

